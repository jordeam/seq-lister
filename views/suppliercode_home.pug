extends base

block content
  h1
    if suppliercode.partnumber !== undefined && suppliercode.partnumber.length > 0
      a.btn.btn-primary(href="/component/"+component.id.toString())
        img(src='/image/back-icon.svg' alt="Voltar" width="20pt" height="24pt")
    if locs.length == 0
      a.btn.btn-primary(href="/suppliercode/"+suppliercode.id.toString()+'/delete')
        img(src='/image/trash-icon.svg' alt="Excluir" width="20pt" height="24pt" onclick="return confirm('Tem certeza que quer excluir o código?');")
    | &nbsp; Código do Componente #{component.name} &mdash; #{compcase.name}
  h2 #[strong Grupo:] #{group.name}
  p

  form(method='POST' action=suppliercode.url)
    div.form-group
      label(for='partnumber') Partnumber:
      input#partnumber.form-control(placeholder='Partnumber' name='partnumber' value=suppliercode.partnumber)

      label(for="manufact") Fabricante:
      select#manufact.form-control(name="manufact")
        each val in manufacturers
          option(value=val.id selected=(val.id === suppliercode.manufact_id) ? "selected" : false) #{val.name}

      label(for='ordercode') Código no fornecedor:
      input#ordercode.form-control(placeholder='Código do fornecedor' name='ordercode' value=suppliercode.ordercode)

      label(for="supplier") Fornecedor:
      select#suppliers.form-control(name="supplier")
        each val in suppliers
          option(value=val.id selected=(val.id === suppliercode.supplier_id) ? "selected" : false) #{val.name}

      label(for='rounding') Arredondamento:
      input#rounding.form-control(placeholder='Arredondamento' name='rounding' value=suppliercode.rounding)

      //- label(for="active") Ativo:
      //- input#active.form-control(name="active" type="checkbox" checked=(suppliercode.active ? "checked" : false))

      label(for='descr') Descrição:
      textarea#descr.form-control(rows="2" placeholder='Descrição' name='descr') #{suppliercode.descr}

    button.btn.btn-primary(type='submit')
      img(src='/image/ok-icon.svg' alt="Atualizar" width="20pt" height="24pt")

  h2 Localizado em:

  dl
    each val in locs
      dd
        a(href="/location/"+val.id class='btn btn-primary')
          img(src="/image/loc-icon.svg" alt="Ir" width="20pt" height="24pt")
        | &nbsp; #{val.name} / #{val.box}: #{val.quant}
