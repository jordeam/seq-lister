h4 Inserindo com Partnumber existente

p Componente encontrado: &nbsp;
  a(href='/component/'+comp.id) #{group.name} - #{comp.name}
  if ccase.name.length > 1
    | (#{ccase.name})

form#insert-comp(method="post" action="/bom/"+loc.id+"/insert")
  input(type="hidden" name="comp_id" value=comp.id)
  input(type='hidden' name="loc_id" value=loc.id)
  input(type="hidden" name="index" value=index)
  input(type="hidden" name="sc_id" value=sc.id)
  p
    label.labelbom(for="qty") Quant.
    input#qty(type="text" name="qty" value=entry.qty)
  p
    label.labelbom(for="round") Arredondamento
    input#round(type="text" name="rounding" value=sc.rounding)
  p
    label.labelbom(for="pn") Partnumber
    input#pn(type="text" name="pn" value=entry.pn readonly)
  p
    label.labelbom(for="manufact") Fabricante:
    select#manufact(name="manufact_id")
      each val in manufacts
        option(value=val.id) #{val.name}
  if sc.ordercode.length > 1
    if sc.ordercode !== entry.ordercode
      p Ordercode do BOM (#{entry.ordercode}) difere do DB (#{sc.ordercode}): usando DB
    label.labelbom(for="order") Ordercode
    input#order(type="text" name="ordercode" value=sc.ordercode)
  else
    label.labelbom(for="order") Ordercode
    input#order(type="text" name="ordercode" value=entry.ordercode)
  p
    label.labelbom(for="supplier") Fornecedor:
    select#supplier(name="supplier_id")
      each val in suppliers
        option(value=val.id selected=(val.id == supplier_default_id) ? "selected" : false) #{val.name}
  p
    label.labelbom.fwidth(for="labels") Labels
    input#labels(type="text" name="labels" value=entry.labels)
  p
    label.labelbom(for="box") Caixa
    input#box(type="text" name="box" value="1")

  button.btn.btn-primary(type="button" onclick="return insertWithPartnumber("+index+");") Inserir

hr
