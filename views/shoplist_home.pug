extends base

block content
  h1 Lista de Compra dos Componentes id=#{id}

  p
    each supplier in suppliers
      div
        a(href="/shoplist/"+supplier.id) #{supplier.name}
        | &nbsp;
  if (id == 0 || id == 1)
    h2 Lista Geral
    p
      a.btn.btn-primary(href="/shoplist/"+id+"/csv")
        img(src='/image/csv-icon.svg' alt="CSV" width="20pt" height="24pt")
    table
      tr
        th Item
        th Grupo
        th Componente
        th Case
        th Estoque
        th Necessário
        th A comprar
        th Fornecedores
        th Inativos

      each val, i in shoplist
        tr
          td #{i+1}
          td #{val.gname}
          td
            a(href='/component/' + val.comp_id) #[Strong #{val.cname}]
          td &nbsp; #{val.case_name}
          td(align="right") #{val.stock}
          td(align="right") #{val.needed}
          td(style="padding-right: 10px;" align="right") #{val.to_buy}
          td #{val.suppliers_a}
          td #{val.suppliers_i}
  else
    h2 Lista #{supplier.name}
    p
      a.btn.btn-primary(href="/shoplist/"+id+"/csv")
        img(src='/image/csv-icon.svg' alt="CSV" width="20pt" height="24pt")
    table
      tr
        th Item
        th Grupo
        th Componente
        th Case
        th Estoque
        th Necessário
        th A comprar
        th PN
        th OrderCode

      each val, i in shoplist
        tr
          td #{i+1}
          td #{val.gname}
          td
            a(href='/component/' + val.comp_id) #[Strong #{val.cname}]
          td &nbsp; #{val.case_name}
          td(align="right") #{val.stock}
          td(align="right") #{val.needed}
          td(style="padding-right: 10px;" align="right") #{val.to_buy}
          td #{val.pn}
          td #{val.ordercode}
