extends base

block content
  h1 Lista de Compras dos Componentes

  p
    a.btn.btn-primary(href="/shoplist/csv")
      img(src='/image/csv-icon.svg' alt="CSV" width="20pt" height="24pt")

  table
    tr
      th Grupo
      th Componente
      th Case
      th Estoque
      th Necessário
      th A comprar
      th Partnumber
      th Ordercode

    each val in shoplist
      tr
        td #{val.gname}
        td
          a(href='/component/' + val.id) #[Strong #{val.cname}]
        td &nbsp; #{val.case_name}
        td(align="right") #{val.stock}
        td(align="right") #{val.needed}
        td(style="padding-right: 10px;" align="right") #{val.to_buy}
        td #{val.partnumber}
        td #{val.supcode}
