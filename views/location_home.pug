extends base

block content
  h1
    a.btn.btn-primary(href="/location")
      img(src="/image/locs-icon.svg" alt="Localizações" width="20pt" height="24pt")
    | &nbsp;
    a.btn.btn-primary(href=location.url+"/csv")
      img(src="/image/csv-icon.svg" alt="CSV" width="20pt" height="24pt")
    | &nbsp;
    a.btn.btn-primary(href="/bom/"+location.id)
      img(src="/image/bom-icon.svg" alt="BOM" width="20pt" height="24pt")
    | &nbsp;
    a.btn.btn-primary(href=location.url+"/labels")
      img(src="/image/label-icon.svg" alt="Etiquetas" width="20pt" height="24pt")
    | &nbsp;
    a.btn.btn-primary
      img(src="/image/edit-icon.svg" alt="Editar" width="20pt" height="24pt" onclick="document.getElementById('edit').style.display='block';document.getElementById('not_edit').style.display='none';")
    if entries.length === 0
      | &nbsp;
      a.btn.btn-primary(href=location.url+"/delete" onclick="return confirm('Tem certeza que quer excluir a localização?')" class='btn btn-primary')
        img(src="/image/trash-icon.svg" alt="Excluir" width="20pt" height="24pt")
    | &nbsp; #[Strong Localização:] #{location.name}

  div#edit(style="display: none;")
    hr
    h2
      a.btn.btn-primary
        img(src="/image/shrink-icon.svg" alt="Cancelar" width="20pt" height="24pt" onclick="document.getElementById('edit').style.display='none';document.getElementById('not_edit').style.display='block';")
      | &nbsp; Editar
    form(name="alter" method="post" action=location.url)
      div.form-group
        label(for='name') Nome:
        input#name.form-control(type="text", placeholder="Nome" name="name" required="true" value=(undefined===location ? '' : location.name))

        label(for='note') Obs.:
        input#note.form-control(type="text", placeholder="Observações e notas" name="note" value=(undefined===location ? '' : location.note))

        label(for='quant') Quantidade a fabricar:
        input#quant.form-control(type="text", placeholder="1" name="quant" required="true" value=(undefined===location ? '' : location.quant))

        label(for='nbox') Quantidade de caixas:
        input#nbox.form-control(type="text", placeholder="1" name="nbox" required="true" value=(undefined===location ? '' : location.nbox))

        label(for="drawBorderline") Ativo:
        input#drawBorderline(type="checkbox" name="active" checked=(location.active ? "checked" : false))
        br

        button(type="submit" class='btn btn-primary')
          img(src="/image/ok-icon.svg" alt="Alterar" width="20pt" height="24pt")

    hr

  div#not_edit(style="display: block;")
    p #[Strong Quantidade a fabricar:] #{location.quant}

    p #[Strong Quantidade de caixas:] #{location.nbox}

    if location.note.length > 0
      p #[Strong Obs.:] #{location.note}

    if location.active
      p Ativo
    else
      p Inativo

  h3
    a.btn.btn-primary(href='/locationentry/choose/'+location.id+(usingTable? "/table" : ""))
      img(src="/image/add-icon.svg" alt="Adicionar" width="20pt" height="24pt")
    | &nbsp; Componentes

  style.
    tr:nth-child(even) { background: #f2f2f2; }
    tr:hover {background-color: #9ee9e9;}
    th {
      background-color: #4CAF50;
      color: white;
      }

  if entries.length > 0
    table
      tr
        th(align="center") #
        th
        th Grupo
        th Componente
        th Case
        th Opt
        th(style="text-align: center;") Partnumber
        th(style="text-align: center;") Ordercode
        th(style="text-align: center;")
          div.tooltipo Cx.
            spqn.tooltipotext Número da caixa
        th(style="text-align: center;")
          div.tooltipo STK
            span.tooltipotext Quantidade em estoque
        th(style="text-align: center;")
          div.tooltipo PU
            span.tooltipotext Por unidade: quantidade necessária por placa
        th Saldo
        th
          div.tooltipo Enviados
            span.tooltipotext Quantidade enviada ao montador de placas
        th Labels

      each val, idx in entries
        tr
          td(align="right") #{idx+1}
          td
            a.btn.btn-primary(href='/locationentry/'+val.id+'/delete' onclick="return confirm('Tem certeza que quer excluir a entrada?');")
              img(src="/image/trash-icon.svg" alt="Excluir" width="12pt" height="15pt")
          td #{val.gname}
          td
            a(href='/component/' + val.component_id) #[Strong #{val.cname}]
          td &nbsp; #{val.csname}
          td
            span.btn.btn-primary(style="padding: 5px; background: #0ef; font-size: 0.8em;") #{val.nOpt}
          td
            a.btn(style="background: #0ef;" href='/suppliercode/'+val.supcode_id)
              span(style="font-size: 0.8em;") #[Strong #{val.partnumber}]
          td
            a.btn(href='/suppliercode/'+val.supcode_id)
              span(style="font-size: 0.8em;") #[Strong #{val.ordercode}]
          td(align="center")
            a.btn(style="background: #0bb;" href="/locationentry/"+val.id) #{val.box}
          td(align="right")
            a.btn(style="background: #0bb;" href="/locationentry/"+val.id) #{val.quant}
          td(style="padding-right: 10px; padding-left: 10px" align="right")
            a.btn(style="background: #0bb;" href="/locationentry/"+val.id) #{val.quant_unit}
          td(style="padding-right: 10px;" align="right") #{val.quant - val.quant_unit * location.quant}
          td(align="right")
            span.btn.btn-primary(style="background: #5df" id=val.id name=val.id value=val.sent onclick="editSent(this);") #{val.sent}
          if Array.isArray(val.labels)
            td
              dd
                each line in val.labels
                  dl= line
          else
            td
              | #{val.labels}
  else
    li Não existem componentes nesta localização.

    hr

    p Inserir componentes de outra localização (sem totais)
    form(name="location_insert_from" method="post" action=location.url+"/insert_from")
      div.form-group
        select.form-control(name="location_id")
          each loc in allLocations
            option(value=loc.id ) #{loc.name}

      button.btn.btn-primary(type="submit") Inserir

  div#sent_dialog.fixed-dialog(style="width: 40%; display: none;")
    form#sent_form
      p
        label(for="sent")
          | Quantidade:
      input#sent(type="text" name="sent" value="0")
      p
        input.btn.btn-primary(type="button" name="close" value="Fechar" onclick="closeSent();")
        | &nbsp;
        input.btn.btn-primary(type="button" name="ok" value="Ok" onclick="okSent();")

  script(src="/script/component_new.js")
  script(src="/script/location_new.js")
