extends base

block content
  h1 #[Strong Busca]
  form(name="alter" method="post" action="/search")
    div.form-group
      - v = undefined === expr ? '' : expr
      label(for='name') Expressão:
      input#name.form-control(type="text", name="expr" required="true" placeholder="digite a expressão de busca aqui." value=v)

      button(type="submit" class='btn btn-primary')
        img(src="/image/ok-icon.svg" alt="Buscar" width="20pt" height="24pt")

  h2 Componentes

  if components !== undefined
    dl
      each val in components
        dd
          a.btn.btn-primary(href='/component/'+val.id)
            img(src="/image/edit-icon.svg" alt="Editar" width="20pt" height="24pt")
          | &nbsp; #{val.name} &mdash; #{val.g_name} &nbsp;
          //- each loc in clocs
          //-   #{loc.name} &nbsp;

  h2 Partnumbers

  if partnumbers !== undefined
    dl
      each val in partnumbers
        dd
          a.btn.btn-primary(href='/component/'+val.id)
            img(src="/image/edit-icon.svg" alt="Editar" width="20pt" height="24pt")
          | &nbsp; #{val.name} &mdash; #{val.g_name}: #{val.partnumber} (#{val.m_name}) &mdash; #{val.ordercode} (#{val.s_name}) &mdash;
          each elt in val.locs
              a.btn.btn-primary(href="/location/"+elt.id)
                img(src="/image/loc-icon.svg" alt="Ir" width="20pt" height="24pt")
              | &nbsp; #{elt.name} / #{elt.box} &nbsp;&nbsp;
  h2 Groups

  if groups !== undefined
    dl
      each val in groups
        dd
          a.btn.btn-primary(href='/group/'+val.id)
            img(src="/image/edit-icon.svg" alt="Editar" width="20pt" height="24pt")
          | &nbsp; #{val.name}
