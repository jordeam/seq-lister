extends base

block content
  h1
    a.btn.btn-primary(href="/location")
      img(src="/image/locs-icon.svg" alt="Localizações" width="20pt" height="24pt")
    | &nbsp;
    if !usingTable
      a.btn.btn-primary(href=location.url)
        img(src="/image/loc-icon.svg" alt="Normal" width="20pt" height="24pt")
    else
      a.btn.btn-primary(href=location.url+"/table")
        img(src="/image/table-icon.svg" alt="Tabela" width="20pt" height="24pt")
    | &nbsp;
    a.btn.btn-primary(href=location.url+"/csv")
      img(src="/image/csv-icon.svg" alt="CSV" width="20pt" height="24pt")
    | &nbsp;
    a.btn.btn-primary(href=location.url+"/labels")
      img(src="/image/label-icon.svg" alt="Etiquetas" width="20pt" height="24pt")
    | &nbsp; #[Strong Localização:] #{location.name}

  p #[Strong Quantidade a fabricar:] #{location.quant}

  p #[Strong Quantidade de caixas:] #{location.nbox}

  if location.note.length > 0
    p #[Strong Obs.:] #{location.note}

  h2 Listagem do esquemático (SCH BOM)

  h3 Upload de arquivo CSV

  form#form_upload(action=location.url+"/upload_bom" method="post" enctype="multipart/form-data")
    label(for="file") Arquivo CSV
    input#file(type="file" name="file1" accept="image/*" capture="environment")
    button.btn.btn-primary Enviar
  p Ao fazer uploar de novo arquivo, os componentes já inseridos permanecerão.

  h2 Listagem dos componentes
