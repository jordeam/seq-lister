extends base

block content
  h1
    a.btn.btn-primary(href=location.url)
      img(src="/image/loc-icon.svg" alt="Localização" width="20pt" height="24pt")
    | &nbsp; #[Strong Localização:] #{location.name}
  p Obs.: #{location.note}

  p #[Strong Quantidade de caixas:] #{location.nbox}


  form(action="/location/"+location.id+"/labels" method="post")
    h2 Dimensões:
    p
      label(for="nColumns") Colunas:
      input#nColumns(type="text" name="nColumns" value="5")
      | &nbsp;
      label(for="nRows") Linhas:
      input#nRows(type="text" name="nRows" value="15" required)
      | &nbsp;
      label(for="initPos") Posição incial:
      input#initPos(type="text" name="initPos" value="1" required)
      | &nbsp;
      label(for="pageWidth") Largura da página (mm):
      input#pageWidth(type="text" name="pageWidth" value="210" required)
      | &nbsp;
      label(for="pageHeight") Altura da página (mm):
      input#pageHeight(type="text" name="pageHeight" value="297" required)
      | &nbsp;
      label(for="topMargin") Margem superior (mm):
      input#topMargin(type="text" name="topMargin" value="2" required)
      | &nbsp;
      label(for="bottomMargin") Margem inferior (mm):
      input#bottomMargin(type="text" name="bottomMargin" value="2" required)
      | &nbsp;
      label(for="leftMargin") Margem esquerda (mm):
      input#leftMargin(type="text" name="leftMargin" value="2" required)
      | &nbsp;
      label(for="rightMargin") Margem direita (mm):
      input#rightMargin(type="text" name="rightMargin" value="2" required)
      | &nbsp;
      label(for="horizSpacing") Inter espaçamento horizontal (mm):
      input#horizSpacing(type="text" name="horizSpacing" value="2" required)
      | &nbsp;
      label(for="drawBorderline") Desenhar borda:
      input#drawBorderline(type="checkbox" name="drawBorderline" checked)

    h2 Etiquetas:

    each _, box in Array(location.nbox)
      p
        label(for="nLabels"+box) Número de etiquetas da caixa #{box+1}/#{location.nbox}:
        select#nLabels(name="nLabels"+box)
          option(value="0") Nenhuma
          option(value="1" selected) 1
          option(value="2") 2
          option(value="3") 3
          option(value="4") 4
    dl
    each val, idx in entries
      dd
        input(type="checkbox" name="sc_"+val.supcode_id)
        | &nbsp; #{idx+1}
        | &nbsp; #{val.gname}: &nbsp;
        a(href='/component/' + val.component_id) #[Strong #{val.cname}]
        | &nbsp;
        if val.csname.length > 0
          | &mdash; #{val.csname}
        | &nbsp;
        a(href='/locationentry/'+val.id) &times;#{val.quant}
        | &nbsp; &middot;#{val.quant_unit} #[Strong cx:]#{val.box} &nbsp; | #{val.labels}
    if entries
      p
        button.btn.btn-primary(type="button" onclick="checkAll(this.form);") Marcar todos
        | &nbsp;
        button.btn.btn-primary(type="button" onclick="uncheckAll(this.form);") Desmarcar
        | &nbsp;
        button.btn.btn-primary Gerar
    else
      li Não existem componentes nesta localização.

  script(src="/script/labels.js")

