extends base

block content
  div#back
    h1
      a.btn.btn-primary(href="/location")
        img(src="/image/locs-icon.svg" alt="Localizações" width="20pt" height="24pt")
      | &nbsp;
      a.btn.btn-primary(href=location.url)
        img(src="/image/loc-icon.svg" alt="Normal" width="20pt" height="24pt")
      | &nbsp; #[Strong BOM - Localização:] #{location.name}

    p #[Strong Quantidade a fabricar:] #{location.quant}

    p #[Strong Quantidade de caixas:] #{location.nbox}

    if location.note.length > 0
      p #[Strong Obs.:] #{location.note}

    h2 Listagem do esquemático (SCH BOM)

    h3 Upload de arquivo CSV

    form#form_upload(action="/bom/"+location.id+"/upload" method="post" enctype="multipart/form-data")
      label(for="file") Arquivo CSV
      input#file(type="file" name="file1" accept="text/csv" capture="environment")
      button.btn.btn-primary Enviar
    p Ao fazer uploar de novo arquivo, os componentes já inseridos na localização permanecerão.

    h2 Listagem dos componentes

    each elt, i in bom
      p
        a(onclick="return statusClicked(this);" name="bom"+i value=location.id+","+i)
          span.btn2.fwidth(style="text-align: center; width: 2em;" id="status"+i) #{elt.status}
        | &nbsp;
        span.btnPN.fwidth(style="text-align: center; width: 3em;" onclick="return byPNClicked(this);" name="bom"+i value=location.id+","+i) = PN
        | &nbsp;
        span.btnPN.fwidth(style="text-align: center; width: 3em;" onclick="return useExistingPNClicked(this);" name="bom"+i value=location.id+","+i) &ne; PN
        | &nbsp;
        span.btnC.fwidth(style="text-align: center; width: 8ch;" onclick="return createCompClicked(this);" name="bom"+i value=location.id+","+i) + Comp
        span.fwidth(style="text-align: right; width: 5ch;") #{elt.qty} &times;
        | &nbsp;
        span.fwidth(style="width: 20ch;") #{elt.compname}
        | &nbsp;
        | ( #[Strong PN:]#{elt.pn} - #[Strong OC#:]#{elt.ordercode}) #{elt.ref}
        | &nbsp; #{elt.foot}
        span &nbsp; #[Strong Desc.:] #{elt.descr}
        span &nbsp; #[Strong Labels:] #{elt.labels}
      div(id="bom"+i)

  div#dialog.fixed-dialog(style="display: none;")
    div#dialog-content
    hr
    button.btn.btn-primary(type="button" onclick="close_dialog();") Fechar

  div#dialog-pn.fixed-dialog(style="display: none;")
    h2 Inserir componente com Partnumber existente
    table
      tr
        td Quantidade:
        td quant
      tr
        td Labels
        td labels
      tr
        th Caixa
        td 1
    hr
    button.btn.btn-primary(type="button" onclick="close_dialog();") Fechar


  script(src="/script/bom.js")
